POSTGRES_USER=metam
POSTGRES_PASSWORD=change-this-in-production
POSTGRES_DB=metam
PGADMIN_DEFAULT_EMAIL=admin@metam.local
PGADMIN_DEFAULT_PASSWORD=change-this-in-production
LOG_LEVEL=INFO
ENABLE_PUBLIC_DEMO=false
PUBLIC_DEMO_TOKEN_MINUTES=120

# JWT signing secrets. Required for any shared, staging, or production
# deployment — if unset, a random secret is generated per process, so
# sessions won't survive a restart and different instances won't agree.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-this-in-production
LEGACY_JWT_SECRET=change-this-in-production
PORTAL_JWT_SECRET=change-this-in-production
MOBILE_JWT_SECRET=change-this-in-production
SUPPLIER_PORTAL_JWT_SECRET=change-this-in-production
